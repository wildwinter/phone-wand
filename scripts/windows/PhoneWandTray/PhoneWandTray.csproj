<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phone Wand.exe, the Windows tray app. Targets .NET Framework 4.8, which ships with Windows 10
       and 11, and builds on any OS through the reference assemblies package (CI builds it on Linux). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Phone Wand</AssemblyName>
    <RootNamespace>PhoneWandTray</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Product>Phone Wand</Product>
    <Company>storytools.se</Company>
    <Copyright>Ian Thomas, storytools.se. MIT licence.</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
